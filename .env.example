# Copia este archivo como .env y pega las llaves temporales del workshop (valen unas horas).
# .env no se versiona y NO se incluye en el .zip de entrega.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Origenes permitidos por CORS (separados por coma). Opcional.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
